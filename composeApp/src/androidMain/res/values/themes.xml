<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Rhythm" parent="Theme.AppCompat.DayNight.NoActionBar" />

    <style name="Theme.Transparent" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!-- Android 12+ Splash Screen Theme -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Background color of the splash screen (matching GCLightBackground / GCLightSurface) -->
        <item name="windowSplashScreenBackground">#FCF8FB</item>
        
        <!-- We use an empty or transparent icon if we want a pure color splash -->
        <item name="windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        
        <!-- Post-splash theme -->
        <item name="postSplashScreenTheme">@style/Theme.Rhythm</item>
    </style>
</resources>
