<?xml version="1.0" encoding="utf-8"?>
<!-- Matches StreakSpotlightWidget.providePreview(): streak=21, habitName="Morning Run",
     sampleCalendar = 3 blank + 19 done + [missed,done,missed,done,done] + 3 not-scheduled + 3 no-data,
     chunked into rows of 7 (Sunday-first, same as computeCurrentMonthCalendar). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_card_bg"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="10dp">

    <ImageView
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/widget_drum_fire"
        android:tint="#006A6A" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="21"
        android:textSize="30sp"
        android:textStyle="bold"
        android:textColor="#191C1C" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DAY STREAK"
        android:textSize="9sp"
        android:textColor="#3E4948" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="July"
        android:textSize="8sp"
        android:textColor="#3E4948" />

    <!-- Row 1: blank, blank, blank, done, done, done, done -->
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:orientation="horizontal" android:gravity="center">
        <ImageView android:layout_width="6dp" android:layout_height="6dp" android:src="@drawable/widget_preview_circle_filled" android:alpha="0.0" />
        <ImageView android:layout_width="2dp" android:layout_height="1dp" />
        <ImageView android:layout_width="6dp" android:layout_height="6dp" android:src="@drawable/widget_preview_circle_filled" android:alpha="0.0" />
        <ImageView android:layout_width="2dp" android:layout_height="1dp" />
        <ImageView android:layout_width="6dp" android:layout_height="6dp" android:src="@drawable/widget_preview_circle_filled" android:alpha="0.0" />
        <ImageView android:layout_width="2dp" android:layout_height="1dp" />
        <ImageView android:layout_width="6dp" android:layout_height="6dp" android:src="@drawable/widget_preview_circle_filled" />
        <ImageView android:layout_width="2dp" android:layout_height="1dp" />
        <ImageView android:layout_width="6dp" android:layout_height="6dp" android:src="@drawable/widget_preview_circle_filled" />
        <ImageView android:layout_width="2dp" android:layout_height="1dp" />
        <ImageView android:layout_width="6dp" android:layout_height="6dp" android:src="@drawable/widget_preview_circle_filled" />
        <ImageView android:layout_width="2dp" android:layout_height="1dp" />
        <ImageView android:layout_width="6dp" android:layout_height="6dp" android:src="@drawable/widget_preview_circle_filled" />
    </LinearLayout>

    <!-- Row 2: all done -->
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:orientation="horizontal" android:gravity="center">
        <ImageView android:layout_width="6dp" android:layout_height="6dp" android:src="@drawable/widget_preview_circle_filled" />
        <ImageView android:layout_width="2dp" android:layout_height="1dp" />
        <ImageView android:layout_width="6dp" android:layout_height="6dp" android:src="@drawable/widget_preview_circle_filled" />
        <ImageView android:layout_width="2dp" android:layout_height="1dp" />
        <ImageView android:layout_width="6dp" android:layout_height="6dp" android:src="@drawable/widget_preview_circle_filled" />
        <ImageView android:layout_width="2dp" android:layout_height="1dp" />
        <ImageView android:layout_width="6dp" android:layout_height="6dp" android:src="@drawable/widget_preview_circle_filled" />
        <ImageView android:layout_width="2dp" android:layout_height="1dp" />
        <ImageView android:layout_width="6dp" android:layout_height="6dp" android:src="@drawable/widget_preview_circle_filled" />
        <ImageView android:layout_width="2dp" android:layout_height="1dp" />
        <ImageView android:layout_width="6dp" android:layout_height="6dp" android:src="@drawable/widget_preview_circle_filled" />
        <ImageView android:layout_width="2dp" android:layout_height="1dp" />
        <ImageView android:layout_width="6dp" android:layout_height="6dp" android:src="@drawable/widget_preview_circle_filled" />
    </LinearLayout>

    <!-- Row 3: all done -->
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:orientation="horizontal" android:gravity="center">
        <ImageView android:layout_width="6dp" android:layout_height="6dp" android:src="@drawable/widget_preview_circle_filled" />
        <ImageView android:layout_width="2dp" android:layout_height="1dp" />
        <ImageView android:layout_width="6dp" android:layout_height="6dp" android:src="@drawable/widget_preview_circle_filled" />
        <ImageView android:layout_width="2dp" android:layout_height="1dp" />
        <ImageView android:layout_width="6dp" android:layout_height="6dp" android:src="@drawable/widget_preview_circle_filled" />
        <ImageView android:layout_width="2dp" android:layout_height="1dp" />
        <ImageView android:layout_width="6dp" android:layout_height="6dp" android:src="@drawable/widget_preview_circle_filled" />
        <ImageView android:layout_width="2dp" android:layout_height="1dp" />
        <ImageView android:layout_width="6dp" android:layout_height="6dp" android:src="@drawable/widget_preview_circle_filled" />
        <ImageView android:layout_width="2dp" android:layout_height="1dp" />
        <ImageView android:layout_width="6dp" android:layout_height="6dp" android:src="@drawable/widget_preview_circle_filled" />
        <ImageView android:layout_width="2dp" android:layout_height="1dp" />
        <ImageView android:layout_width="6dp" android:layout_height="6dp" android:src="@drawable/widget_preview_circle_filled" />
    </LinearLayout>

    <!-- Row 4: done, missed, done, missed, done, done, not-scheduled -->
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:orientation="horizontal" android:gravity="center">
        <ImageView android:layout_width="6dp" android:layout_height="6dp" android:src="@drawable/widget_preview_circle_filled" />
        <ImageView android:layout_width="2dp" android:layout_height="1dp" />
        <ImageView android:layout_width="6dp" android:layout_height="6dp" android:src="@drawable/widget_preview_circle_filled" android:alpha="0.22" />
        <ImageView android:layout_width="2dp" android:layout_height="1dp" />
        <ImageView android:layout_width="6dp" android:layout_height="6dp" android:src="@drawable/widget_preview_circle_filled" />
        <ImageView android:layout_width="2dp" android:layout_height="1dp" />
        <ImageView android:layout_width="6dp" android:layout_height="6dp" android:src="@drawable/widget_preview_circle_filled" android:alpha="0.22" />
        <ImageView android:layout_width="2dp" android:layout_height="1dp" />
        <ImageView android:layout_width="6dp" android:layout_height="6dp" android:src="@drawable/widget_preview_circle_filled" />
        <ImageView android:layout_width="2dp" android:layout_height="1dp" />
        <ImageView android:layout_width="6dp" android:layout_height="6dp" android:src="@drawable/widget_preview_circle_filled" />
        <ImageView android:layout_width="2dp" android:layout_height="1dp" />
        <ImageView android:layout_width="6dp" android:layout_height="6dp" android:src="@drawable/widget_preview_circle_filled" android:tint="#3E4948" android:alpha="0.15" />
    </LinearLayout>

    <!-- Row 5: not-scheduled, not-scheduled, no-data, no-data, no-data -->
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:orientation="horizontal" android:gravity="center">
        <ImageView android:layout_width="6dp" android:layout_height="6dp" android:src="@drawable/widget_preview_circle_filled" android:tint="#3E4948" android:alpha="0.15" />
        <ImageView android:layout_width="2dp" android:layout_height="1dp" />
        <ImageView android:layout_width="6dp" android:layout_height="6dp" android:src="@drawable/widget_preview_circle_filled" android:tint="#3E4948" android:alpha="0.15" />
        <ImageView android:layout_width="2dp" android:layout_height="1dp" />
        <ImageView android:layout_width="6dp" android:layout_height="6dp" android:src="@drawable/widget_preview_circle_filled" android:alpha="0.10" />
        <ImageView android:layout_width="2dp" android:layout_height="1dp" />
        <ImageView android:layout_width="6dp" android:layout_height="6dp" android:src="@drawable/widget_preview_circle_filled" android:alpha="0.10" />
        <ImageView android:layout_width="2dp" android:layout_height="1dp" />
        <ImageView android:layout_width="6dp" android:layout_height="6dp" android:src="@drawable/widget_preview_circle_filled" android:alpha="0.10" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Morning Run"
        android:textSize="9sp"
        android:textColor="#3E4948" />
</LinearLayout>
