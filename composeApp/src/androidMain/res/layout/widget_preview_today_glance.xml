<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_card_bg"
    android:orientation="vertical"
    android:padding="20dp"
    android:gravity="center_vertical">

    <!-- Matches TodayGlanceWidget.providePreview(): done=4, total=6 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_widget_check_circle" android:tint="#006A6A" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp"
            android:text="4 of 6 habits done" android:textSize="12sp" android:textColor="#191C1C" />
    </LinearLayout>

    <ImageView android:layout_width="match_parent" android:layout_height="1dp" android:background="#22006A6A" />

    <!-- Matches TodayGlanceWidget.providePreview(): pendingTodos=3 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_widget_checklist" android:tint="#006A6A" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp"
            android:text="3 to-dos pending" android:textSize="12sp" android:textColor="#191C1C" />
    </LinearLayout>

    <ImageView android:layout_width="match_parent" android:layout_height="1dp" android:background="#22006A6A" />

    <!-- Matches TodayGlanceWidget.providePreview(): sampleReminder title "Morning Run", +2h (exact time is inherently
         dynamic in the live widget too, not something a static asset can pixel-match) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_widget_notifications" android:tint="#006A6A" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp"
            android:text="Morning Run — 2:00 PM" android:textSize="12sp" android:textColor="#191C1C" />
    </LinearLayout>
</LinearLayout>
